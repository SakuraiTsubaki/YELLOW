{
  "schema_version": 2,
  "project": "YELLOW",
  "target": {
    "platform_family": "game-boy",
    "runtime_base": "original-yellow",
    "master_reference": "Japanese Yellow revisions",
    "gba_remake_is_separate": true
  },
  "language_priority": [
    "ja",
    "ko",
    "en"
  ],
  "source_evidence": {
    "rom_manifest": "manifests/rom-baselines.csv",
    "legacy_save_profiles": "manifests/legacy-save-profiles.json",
    "hardware_capacity": "manifests/hardware-capacity.yml",
    "require_hash_bound_rom_identity": true,
    "do_not_conflate_rom_and_save_identity": true
  },
  "cartridge_profiles": {
    "legacy_jp": {
      "mapper": "MBC3+RAM+BATTERY",
      "cartridge_type": 19,
      "rom_bytes": 1048576,
      "sram_bytes": 32768
    },
    "legacy_intl": {
      "mapper": "MBC5+RAM+BATTERY",
      "cartridge_type": 27,
      "rom_bytes": 1048576,
      "sram_bytes": 32768
    },
    "expanded": {
      "mapper": "MBC5+RAM+BATTERY",
      "cartridge_type": 27,
      "rom_max_bytes": 8388608,
      "rom_banks": 512,
      "rom_bank_size": 16384,
      "rom_bank_bits": 9,
      "sram_max_bytes": 131072,
      "sram_banks": 16,
      "sram_bank_size": 8192,
      "sram_bank_bits": 4
    }
  },
  "generation_policy": {
    "known_through": 9,
    "reserved_from": 10,
    "generation_id_bits": 8,
    "guess_future_content_counts": false
  },
  "id_policy": {
    "species_bits": 16,
    "form_bits": 16,
    "move_bits": 16,
    "item_bits": 16,
    "ability_bits": 16,
    "type_bits": 16,
    "location_bits": 16,
    "map_bits": 16,
    "none": 0,
    "invalid": 65535,
    "max_valid": 65534,
    "table_counts_are_data_driven": true
  },
  "banking_policy": {
    "banked_pointer_bytes": 3,
    "require_mbc5_high_rom_bank_bit": true,
    "do_not_store_expanded_rom_bank_in_u8": true,
    "reserve_bank_zero_semantics": true
  },
  "save_policy": {
    "legacy_profiles": [
      "yellow-jp-legacy",
      "yellow-intl-legacy"
    ],
    "legacy_sram_bytes": 32768,
    "expanded_sram_bytes": 131072,
    "schema_version_bits": 16,
    "current_schema": 1,
    "migration_required_on_layout_change": true,
    "preserve_source_profile_and_hash": true
  }
}
